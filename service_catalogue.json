    {
      "id": "HANDYMAN_MINOR",
      "name": "General Handyman / Minor Repairs",
      "category": "General",
      "urgency_tier": "P3",
      "signals": ["small non-specialist fixes", "furniture assembly", "hanging fixtures", "patching, adjusting, tightening", "no trade licence required"],
      "required_intake_fields": ["site_location", "task_description", "preferred_dates"],
      "sla_hours": 120,
      "delivery": "on_site",
      "prerequisites": []
    }
  ]
